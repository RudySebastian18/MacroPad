<Window x:Class="MacroPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroPad"
        Height="780" Width="1000" MinHeight="620" MinWidth="900"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- ============ Paleta: dark premium, acento azul eléctrico ============ -->
        <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0F19" Offset="0"/>
            <GradientStop Color="#0D1424" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#141B2D"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0F1626"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#1A2438"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#212E4A"/>
        <SolidColorBrush x:Key="InkBrush" Color="#E5EAF5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B97B0"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#5E6B87"/>
        <SolidColorBrush x:Key="LineBrush" Color="#243049"/>
        <SolidColorBrush x:Key="FieldLineBrush" Color="#2A3857"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B97F8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F6FE4"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#16264A"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ============ Íconos (Segoe Fluent Icons) ============ -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Tarjeta ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ============ Barras de desplazamiento finas ============ -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#2F3E5E" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Botón secundario (estilo por defecto) ============ -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Botón principal (azul eléctrico con resplandor) ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Campo de texto con placeholder y brillo al enfocar ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Top"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource PlaceholderBrush}"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Top"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Casilla de verificación ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6"
                                    Background="{StaticResource ControlBrush}"
                                    BorderBrush="{StaticResource FieldLineBrush}" BorderThickness="1">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="White" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Listas (registro y dispositivos) ============ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18233C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Selector de tipo de acción (chips) ============ -->
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip" Background="{StaticResource ControlBrush}"
                                            BorderBrush="{StaticResource FieldLineBrush}" BorderThickness="1"
                                            CornerRadius="16" Padding="13,6" Margin="0,0,8,8">
                                        <ContentPresenter x:Name="Cp" TextElement.Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource InkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Pestañas con subrayado azul ============ -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,18,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#A9B4CC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="18,10" Margin="0,0,8,-1" CornerRadius="10,10,0,0"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18233C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Teclas dibujadas: la animación y el resplandor se controlan desde el código ============ -->
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Aparición suave de la ventana -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- ========================= Contenido principal ========================= -->
        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Encabezado: ícono, título y estado del modo macro ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="HeaderIcon" Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MacroPad" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusHint" Text="" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <!-- Píldora de estado con punto pulsante -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Perfil activo -->
                <Border x:Name="ProfilePill" CornerRadius="20" Padding="14,9" Margin="0,0,10,0" BorderThickness="1"
                        Background="#141B2D" BorderBrush="#2A3857" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ProfileIcon" Style="{StaticResource Icon}" Text="&#xE77B;"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ProfilePillText" Text="General · automático" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="20" Padding="16,9" BorderThickness="1" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush x:Name="PillBg" Color="#141B2D"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="PillBorder" Color="#2A3857"/>
                    </Border.BorderBrush>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,11,0" VerticalAlignment="Center">
                            <Ellipse x:Name="PulseRing" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#3B82F6"/>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="PillDot" Color="#6B7A99"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="DotGlow" Color="#3B82F6" BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="Modo macro" FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="PillText" Color="#9AA6BF"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Acciones generales ===== -->
            <StackPanel Grid.Row="1" Margin="0,20,0,16">
                <WrapPanel>
                    <Button Margin="0,0,10,8" Click="ToggleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,9,0"/>
                            <TextBlock Text="Alternar modo macro"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,10,8" Click="ReloadButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,9,0"/>
                            <TextBlock Text="Recargar configuración"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,10,8" Click="OpenFolderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,9,0"/>
                            <TextBlock Text="Abrir carpeta de configuración"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,10,8" Click="ExportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" Margin="0,0,9,0"/>
                            <TextBlock Text="Exportar"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,22,8" Click="ImportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,9,0"/>
                            <TextBlock Text="Importar"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="AutoStartCheck" Content="Iniciar con Windows"
                              VerticalAlignment="Center" Margin="0,0,0,8"
                              Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>
                </WrapPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"
                           Text="Modo macro = Num Lock apagado. La X de la ventana la oculta en la bandeja; para salir usa el menú del ícono."/>
            </StackPanel>

            <TabControl x:Name="MainTabs" Grid.Row="2" SelectionChanged="MainTabs_SelectionChanged">

                <!-- ========== Pestaña 1: teclado + panel de edición ========== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Margin="0,0,9,0"/>
                            <TextBlock Text="Teclado"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                        <!-- ===== Perfiles ===== -->
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,6,18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,18,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Perfiles" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ListBox x:Name="ProfileList" Grid.Column="1" Style="{StaticResource ChipList}"
                                             DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged"/>

                                    <WrapPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Button x:Name="NewProfileButton" Margin="14,0,8,0" Padding="12,6" Click="NewProfileButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/>
                                                <TextBlock Text="Nuevo"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RenameProfileButton" Margin="0,0,8,0" Padding="12,6" Click="RenameProfileButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,8,0"/>
                                                <TextBlock Text="Renombrar"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DeleteProfileButton" Padding="12,6" Click="DeleteProfileButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0"/>
                                                <TextBlock Text="Eliminar"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Se activa con" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBox x:Name="ProfileAppsBox" Grid.Column="1" Tag="Ej. excel, winword"
                                             LostFocus="ProfileAppsBox_LostFocus"/>
                                    <Button x:Name="ProfileAppsPick" Grid.Column="2" Margin="10,0,0,0" Click="ProfileAppsPick_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,8,0"/>
                                            <TextBlock Text="Programas abiertos"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="ProfileAppsHint" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,8,0,12"/>

                                <CheckBox x:Name="PinCheck" Content="Fijar este perfil (ignorar la ventana activa)"
                                          Checked="PinCheck_Changed" Unchecked="PinCheck_Changed"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tarjeta del teclado (las teclas se crean desde el código) -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="22">
                                <Grid x:Name="KeyGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="78"/>
                                        <RowDefinition Height="78"/>
                                        <RowDefinition Height="78"/>
                                        <RowDefinition Height="78"/>
                                        <RowDefinition Height="78"/>
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Border>

                            <!-- Tarjeta de edición -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,6,0"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="500" MinWidth="400">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="22"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Configurar acción" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12"/>
                                    <TextBlock x:Name="SelectedKeyText" Text="Haz clic en una tecla para asignarle una acción"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <StackPanel x:Name="EditPanel" IsEnabled="False">
                                        <TextBlock Text="Nombre de la acción" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NameBox" Tag="Ej. Abrir mi proyecto" Margin="0,0,0,16"/>

                                        <TextBlock Text="Tipo de acción" Style="{StaticResource FieldLabel}"/>
                                        <ListBox x:Name="TypeCombo" Style="{StaticResource ChipList}" Margin="0,0,0,8"
                                                 DisplayMemberPath="Label" SelectedValuePath="Type"
                                                 SelectionChanged="TypeCombo_SelectionChanged"/>

                                        <TextBlock Text="Valor" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ValueBox" Tag="Ruta del programa o URL..."/>
                                        <WrapPanel x:Name="ProgramTools" Margin="0,10,0,0">
                                            <Button x:Name="BrowseButton" Margin="0,0,8,0" Click="BrowseButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="BrowseLabel" Text="Examinar..."/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PickButton" Click="PickButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="PickLabel" Text="Programas abiertos"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock x:Name="HintText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,8,0,22"/>

                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" Click="SaveButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,9,0"/>
                                                    <TextBlock Text="Guardar"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,10,8" Click="TestButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,9,0"/>
                                                    <TextBlock Text="Probar"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,10,8" Click="RemoveButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,9,0"/>
                                                    <TextBlock Text="Quitar asignación"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Pestaña 2: registro y dispositivos ========== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,9,0"/>
                            <TextBlock Text="Registro y dispositivos"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="110"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Teclados conectados" Style="{StaticResource FieldLabel}"/>
                            <ListBox x:Name="DeviceList" Grid.Row="1" FontFamily="Consolas" FontSize="11"/>
                            <Button Grid.Row="2" HorizontalAlignment="Left" Margin="0,12,0,16" Click="RefreshButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,9,0"/>
                                    <TextBlock Text="Actualizar lista"/>
                                </StackPanel>
                            </Button>

                            <DockPanel Grid.Row="3">
                                <TextBlock DockPanel.Dock="Top" Text="Registro" Style="{StaticResource FieldLabel}"/>
                                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ========================= Selector de programas abiertos ========================= -->
        <Grid x:Name="PickerOverlay" Visibility="Collapsed" Opacity="0" Background="#CC070A12">
            <Border Style="{StaticResource Card}" Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="20"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Programas abiertos" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"
                               Text="Elige uno para usar su ruta exacta y evitar errores al escribirla. Abre antes el programa si no aparece."/>

                    <TextBox Grid.Row="2" x:Name="PickerSearch" Tag="Buscar por nombre o ventana..."
                             TextChanged="PickerSearch_TextChanged" Margin="0,0,0,12"/>

                    <ListBox Grid.Row="3" x:Name="PickerList" Height="290" MouseDoubleClick="PickerList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PickerStatus" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancelar" Margin="0,0,10,0" Click="PickerCancel_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Click="PickerUse_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,9,0"/>
                                    <TextBlock Text="Usar este programa"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================= Cuadro de nombre / confirmación ========================= -->
        <Grid x:Name="PromptOverlay" Visibility="Collapsed" Opacity="0" Background="#CC070A12">
            <Border Style="{StaticResource Card}" Width="430" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <StackPanel>
                    <TextBlock x:Name="PromptTitle" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PromptMessage" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBox x:Name="PromptBox" Tag="Nombre del perfil" Margin="0,16,0,0" KeyDown="PromptBox_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancelar" Margin="0,0,10,0" Click="PromptCancel_Click"/>
                        <Button x:Name="PromptOk" Content="Aceptar" Style="{StaticResource PrimaryButton}" Click="PromptOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================= Notificación (toast) ========================= -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30"
                Background="#18223A" BorderBrush="#2A3857" BorderThickness="1" CornerRadius="14"
                Padding="14,12,20,12" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastMove" X="24"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush x:Name="ToastTint" Color="#123D31"/>
                    </Border.Background>
                    <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14"
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="ToastColor" Color="#34D399"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" MaxWidth="340" TextWrapping="Wrap"
                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
